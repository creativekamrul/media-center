<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp" android:background="#19241F">
<TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Media Center" android:textSize="17sp" android:textColor="#EFF3EF" android:maxLines="1" android:ellipsize="end"/>
<TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open your library" android:textColor="#A5AFA9" android:maxLines="1" android:ellipsize="end"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center">
<ImageButton android:id="@+id/widget_previous" android:layout_width="56dp" android:layout_height="48dp" android:src="@android:drawable/ic_media_previous" android:contentDescription="Previous" android:background="#19241F"/>
<ImageButton android:id="@+id/widget_play" android:layout_width="56dp" android:layout_height="48dp" android:src="@android:drawable/ic_media_play" android:contentDescription="Play or pause" android:background="#19241F"/>
<ImageButton android:id="@+id/widget_next" android:layout_width="56dp" android:layout_height="48dp" android:src="@android:drawable/ic_media_next" android:contentDescription="Next" android:background="#19241F"/>
</LinearLayout></LinearLayout>