{
  "name": "media-center",
  "version": "1.1.1",
  "private": true,
  "description": "A desktop home for music, audiobooks, and podcasts",
  "author": "Media Center",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "package:win": "npm run build:media-controls && npm run build && electron-builder --win nsis --x64 --publish never",
    "package:dir": "npm run build:media-controls && npm run build && electron-builder --dir",
    "release:check": "node scripts/release-check.cjs",
    "release:assets": "node scripts/release-assets.cjs",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-version.ps1",
    "test:updater": "node scripts/test-updater.cjs",
    "release:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/publish-version.ps1 -DryRun",
    "build:media-controls": "node scripts/build-media-controls.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "music-metadata": "^11.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "playwright": "^1.55.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "local.mediacenter.desktop",
    "productName": "Media Center",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "README.md",
      "docs/**/*",
      "THIRD_PARTY_NOTICES.md",
      "CHANGELOG.md",
      "CONTRIBUTING.md",
      "SECURITY.md"
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "artifacts/smtc",
        "to": "smtc",
        "filter": [
          "*.exe",
          "*.dll",
          "notices/**/*"
        ]
      }
    ],
    "artifactName": "Media-Center-${version}-win-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "creativekamrul",
      "repo": "media-center",
      "releaseType": "release"
    }
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/creativekamrul/media-center.git"
  },
  "homepage": "https://github.com/creativekamrul/media-center"
}
